{
  "manifest_version": 3,
  "name": "Lightweight Bookmark",
  "version": "1.0",
  "description": "A fast, simple, and lightweight bookmark manager.",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Bookmarks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
